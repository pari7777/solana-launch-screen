# Base launch screen — set these in Railway → Variables
DATABASE_URL=            # ${{Postgres.DATABASE_URL}} on Railway; empty = embedded Postgres
AUTO_BUY=true            # paper-buy coins that reach SELECT_FOR_REVIEW
BUY_ETH=0.01
PAPER_START_ETH=0.5      # changing this starts a fresh paper balance
TRAILING_DRAWDOWN=0.35
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_ETH=0.1
DASHBOARD_PASSWORD=      # any username + this password; unset = temporary password printed in the logs
# BASE_RPC_URL=https://mainnet.base.org,https://base-rpc.publicnode.com
