# ── Angel One SmartAPI (create an app at smartapi.angelone.in; never commit real values) ──
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=          # the base32 secret shown when you enable TOTP (not the 6-digit code)

# ── Claude decision support (optional; Claude can only veto) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_CALLS_PER_HOUR=60

# ── mode: paper by default. Live needs ALL THREE lines below + credentials ──
TRADING_MODE=paper
LIVE_TRADING_CONFIRM=NO
STATIC_IP_REGISTERED=false
ORDER_TAG=AQAI
PAPER_CAPITAL=100000

# ── risk ──
MAX_RISK_PER_TRADE_PCT=0.5
MAX_CAPITAL_PER_TRADE_PCT=10
MAX_OPEN_POSITIONS=4
MAX_DAILY_LOSS_PCT=2
MAX_WEEKLY_LOSS_PCT=5
MAX_DRAWDOWN_PCT=10
MAX_CONSECUTIVE_LOSSES=4
MIN_NET_REWARD_RUPEES=150
MIN_REWARD_RISK=1.5

# ── universe ──
STOCK_UNIVERSE=RELIANCE,HDFCBANK,ICICIBANK,INFY,TCS,SBIN,AXISBANK,KOTAKBANK,LT,BHARTIARTL
OPTION_UNDERLYINGS=NIFTY,BANKNIFTY,FINNIFTY

# ── infra ──
DATABASE_URL=
REDIS_URL=
DASHBOARD_PASSWORD=
