# ═══ Paste into Railway → your service → Variables → Raw Editor ═══
MODE=paper
CONFIRM_LIVE=NO
AUTO_BUY=true
DASHBOARD_PASSWORD=choose-a-strong-password

# Free key from helius.dev
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Railway Postgres (add it with  + New → Database → PostgreSQL); this reference fills itself in
DATABASE_URL=${{Postgres.DATABASE_URL}}

BUY_SOL=0.05
TRAILING_DRAWDOWN=0.35
MAX_OPEN_POSITIONS=3
DAILY_LOSS_LIMIT_SOL=0.5

# keypair mode only — private key of a SEPARATE small bot wallet (base58). Never use your main wallet.
# BOT_PRIVATE_KEY=

# optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OUTPUT_WEBHOOK_URL=
