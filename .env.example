# ═══ solana-launch-screen settings ═══  (copy this file to .env)

# ── How to trade ──────────────────────────────────────────────────────────
# paper   = fake money, real launches (start here)
# browser = link Phantom / Solflare in the dashboard; you approve every buy and sell
# keypair = a separate bot wallet on this laptop signs automatically (needs CONFIRM_LIVE=YES)
MODE=paper
CONFIRM_LIVE=NO
AUTO_BUY=true
PAUSED=false
KEYPAIR_PATH=./bot-wallet.json
# BOT_PRIVATE_KEY=            # alternative to KEYPAIR_PATH (base58). Never share it.

# ── Data sources (free Helius key: helius.dev) ───────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
STREAM=auto                    # auto | rpc | pumpportal
RPC_CONCURRENCY=8
CHECK_PUMPFUN_API=true
CHECK_METADATA=false

# ── Database ─────────────────────────────────────────────────────────────
# Empty = embedded Postgres in ./data (nothing to install). Or use your own:
# DATABASE_URL=postgres://user:pass@localhost:5432/launches
DATA_DIR=./data
RULE_RESULTS_STORE=nonpass      # all | nonpass | triggered
RETENTION_DAYS=14

# ── Screening timeline ───────────────────────────────────────────────────
DECISION_SECONDS=6
OBSERVE_SECONDS=3
RECHECK_AT=15,30
STAGE2_BUDGET_SECONDS=3
SELECT_SCORE=80
MONITOR_SCORE=60
TRACE_BUYERS=4
MIN_TRACE_SOL=0.05
TRACK_CREATORS_MINUTES=30
DEV_DUMP_PCT=70
SERVICE_SPAN_MINUTES=60
RULES_OVERRIDE_PATH=./config/rules-overrides.json

# ── Trade size & costs ───────────────────────────────────────────────────
BUY_SOL=0.05
SLIPPAGE_PCT=15
PRIORITY_FEE=0.0005
FEE_PCT=1.25
PUMPSWAP_FEE_PCT=0.3
PLATFORM_FEE_PCT=0.5
PAPER_START_SOL=5
PAPER_SLIPPAGE_PCT=5

# ── Exits & risk limits ──────────────────────────────────────────────────
TRAILING_DRAWDOWN=0.35          # exit when net liquidation value falls 35% below its high-water mark
TAKE_PROFIT_PCT=0               # optional fixed exits (0 = off)
STOP_LOSS_PCT=0
MAX_HOLD_MINUTES=10
WHALE_EXIT_PCT=50
MAX_OPEN_POSITIONS=3
MAX_BUYS_PER_HOUR=6
DAILY_LOSS_LIMIT_SOL=0.5
BROWSER_AUTO_PROMPT_EXITS=true

# ── Outputs ──────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
TERMINAL_SHOW=ALL               # or e.g. SELECT_FOR_REVIEW,MONITOR
LOG_JSON=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OUTPUT_WEBHOOK_URL=
WEBHOOK_DECISIONS=SELECT_FOR_REVIEW
